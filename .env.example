# filename: .env.example
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:3000
ONYX_CONFIG_PATH=/absolute/path/to/onyx-database.json
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=
STORE_ADMIN_EMAIL=
# Explicit opt-in. Demo is rejected when APP_ENV=production.
CHECKOUT_MODE=demo
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Preview is safe by default. Demo orders never send SMTP mail.
EMAIL_MODE=preview
SMTP_URL=
MAIL_FROM=
