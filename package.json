{
  "name": "ecommerce-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test && npm run build",
    "check:all": "npm run check && npm run test:e2e",
    "schema:validate": "tsx scripts/schema.ts validate",
    "schema:diff": "tsx scripts/schema.ts diff",
    "schema:publish": "tsx scripts/schema.ts publish",
    "seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "test:preview": "node --conditions=react-server --import tsx tests/fixture/preview.ts --production",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "bootstrap:admin": "node --conditions=react-server --import tsx scripts/bootstrap-admin.ts",
    "schema:generate": "onyx-gen --source file --schema api/onyx.schema.json --out lib/onyx/generated.ts --timestamps string --optional none",
    "maintenance": "node --conditions=react-server --import tsx scripts/maintenance.ts",
    "template:init": "node scripts/init-template.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.4.0",
    "@onyx.dev/onyx-database": "2.8.4",
    "@radix-ui/react-slot": "1.3.0",
    "@tanstack/react-table": "9.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.1.0",
    "firebase-admin": "14.5.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.81.0",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7",
    "@tiptap/react": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "zustand": "5.0.16",
    "decimal.js": "10.6.0",
    "embla-carousel-react": "8.6.0",
    "stripe": "23.0.1",
    "nodemailer": "10.2.1",
    "@react-email/render": "2.1.1",
    "react-email": "6.11.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "firebase-tools": "15.34.1",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "@types/nodemailer": "8.0.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/dom": "10.4.2",
    "jsdom": "30.1.3"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "overrides": {
    "postcss": "8.5.31",
    "@grpc/grpc-js": "1.14.6"
  }
}
